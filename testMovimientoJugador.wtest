import wollok.game.*
import direcciones.*

describe "Movimiento" {

    test "mover hacia arriba cambia Y" {
        const posicion = new Posicion(x = 1, y = 1)

        const nueva = posicion.mover(arriba)

        assert.equals(1, nueva.x())
        assert.equals(2, nueva.y())
    }

    test "mover hacia abajo cambia Y" {
        const posicion = new Posicion(x = 1, y = 2)

        const nueva = posicion.mover(abajo)

        assert.equals(1, nueva.x())
        assert.equals(1, nueva.y())
    }

}