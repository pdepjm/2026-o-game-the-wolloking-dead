import laberinto.*

describe "matrices del laberinto" {

    test "cada matriz cabe en el tablero y marca inicio, salida y minotauro" {
        assert.equals(5, juegoLaberinto.matrices().size())

        const alturasCruce = [3, 4, 5, 3, 6]
        const columnasAlternativas = [5, 3, 7, 4, 6]
        const caminosTerciarios = [
            [[1, 1], [1, 2], [1, 3], [2, 3], [3, 3], [4, 3], [5, 3], [5, 4], [5, 5], [5, 6], [6, 6], [7, 6], [8, 6], [9, 6], [9, 7], [9, 8], [9, 9], [9, 10], [10, 10]],
            [[1, 1], [1, 2], [1, 3], [1, 4], [2, 4], [3, 4], [3, 5], [3, 6], [4, 6], [5, 6], [6, 6], [7, 6], [8, 6], [9, 6], [9, 7], [9, 8], [9, 9], [9, 10], [10, 10]],
            [[1, 1], [1, 2], [1, 3], [1, 4], [1, 5], [2, 5], [3, 5], [4, 5], [5, 5], [6, 5], [7, 5], [7, 6], [7, 7], [7, 8], [7, 9], [8, 9], [9, 9], [10, 9], [10, 10]],
            [[1, 1], [1, 2], [1, 3], [2, 3], [3, 3], [4, 3], [4, 4], [4, 5], [4, 6], [5, 6], [6, 6], [7, 6], [8, 6], [9, 6], [9, 7], [9, 8], [9, 9], [9, 10], [10, 10]],
            [[1, 1], [1, 2], [1, 3], [1, 4], [1, 5], [1, 6], [2, 6], [3, 6], [4, 6], [5, 6], [6, 6], [6, 7], [6, 8], [6, 9], [7, 9], [8, 9], [9, 9], [10, 9], [10, 10]]
        ]
        const caminosAdicionales = [
            [[1, 1], [2, 1], [3, 1], [4, 1], [5, 1], [5, 2], [6, 2], [7, 2], [7, 3], [8, 3], [9, 3], [9, 4], [9, 5], [9, 6], [9, 7], [9, 8], [9, 9], [10, 9], [10, 10]],
            [[1, 1], [2, 1], [3, 1], [3, 2], [3, 3], [4, 3], [4, 4], [5, 4], [6, 4], [7, 4], [8, 4], [9, 4], [9, 5], [9, 6], [9, 7], [9, 8], [9, 9], [10, 9], [10, 10]],
            [[1, 1], [2, 1], [3, 1], [4, 1], [5, 1], [6, 1], [7, 1], [7, 2], [7, 3], [7, 4], [8, 4], [8, 5], [9, 5], [9, 6], [9, 7], [9, 8], [9, 9], [10, 9], [10, 10]],
            [[1, 1], [2, 1], [3, 1], [4, 1], [4, 2], [5, 2], [5, 3], [6, 3], [7, 3], [8, 3], [9, 3], [9, 4], [9, 5], [9, 6], [9, 7], [9, 8], [9, 9], [10, 9], [10, 10]],
            [[1, 1], [2, 1], [3, 1], [4, 1], [5, 1], [6, 1], [6, 2], [6, 3], [6, 4], [6, 5], [7, 5], [7, 6], [8, 6], [9, 6], [9, 7], [9, 8], [9, 9], [10, 9], [10, 10]]
        ]
        const ramasFalsas = [
            [[[5, 6], [4, 6], [3, 6], [2, 6]], [[7, 3], [7, 2], [7, 1]]],
            [[[6, 4], [6, 3], [6, 2]], [[3, 7], [2, 7]]],
            [[[3, 5], [3, 4], [3, 3]], [[8, 9], [8, 10]]],
            [[[7, 3], [7, 4]], [[4, 9], [3, 9], [2, 9]]],
            [[[2, 6], [2, 7], [2, 8]], [[8, 9], [8, 10]]]
        ]
        var indiceMatriz = 0

        juegoLaberinto.matrices().forEach({ matriz =>
            assert.equals(12, matriz.size())
            matriz.forEach({ fila =>
                assert.equals(12, fila.size())
            })

            const filaSalida = matriz.get(1)
            const filaMinotauro = matriz.get(5)
            const filaInicio = matriz.get(10)

            assert.equals(5, filaSalida.get(10))
            assert.equals(0, filaInicio.get(1))
            assert.equals(0, filaMinotauro.get(9))

            var cantidadSalidas = 0
            var cantidadPortales = 0
            var cantidadPinchos = 0
            var cantidadPegamento = 0
            matriz.forEach({ fila =>
                fila.forEach({ elemento =>
                    if (elemento == 5) {
                        cantidadSalidas = cantidadSalidas + 1
                    }
                    if (elemento == 4) {
                        cantidadPortales = cantidadPortales + 1
                    }
                    if (elemento == 3) {
                        cantidadPinchos = cantidadPinchos + 1
                    }
                    if (elemento == 2) {
                        cantidadPegamento = cantidadPegamento + 1
                    }
                })
            })
            assert.equals(1, cantidadSalidas)
            assert.equals(4, cantidadPortales)
            assert.equals(true, cantidadPinchos >= 2)
            assert.equals(true, cantidadPegamento >= 2)

            const alturaCruce = alturasCruce.get(indiceMatriz)
            const columnaAlternativa = columnasAlternativas.get(indiceMatriz)
            var primerCaminoLibre = true
            var segundoCaminoLibre = true

            (1..alturaCruce).forEach({ y =>
                if (self.esParedOPortal(matriz, 1, y)) {
                    primerCaminoLibre = false
                }
            })
            (1..9).forEach({ x =>
                if (self.esParedOPortal(matriz, x, alturaCruce)) {
                    primerCaminoLibre = false
                }
            })
            (alturaCruce..10).forEach({ y =>
                if (self.esParedOPortal(matriz, 9, y)) {
                    primerCaminoLibre = false
                }
            })

            (1..columnaAlternativa).forEach({ x =>
                if (self.esParedOPortal(matriz, x, 1)) {
                    segundoCaminoLibre = false
                }
            })
            (1..9).forEach({ y =>
                if (self.esParedOPortal(matriz, columnaAlternativa, y)) {
                    segundoCaminoLibre = false
                }
            })
            (columnaAlternativa..10).forEach({ x =>
                if (self.esParedOPortal(matriz, x, 9)) {
                    segundoCaminoLibre = false
                }
            })
            (9..10).forEach({ y =>
                if (self.esParedOPortal(matriz, 10, y)) {
                    segundoCaminoLibre = false
                }
            })

            assert.equals(true, primerCaminoLibre)
            assert.equals(true, segundoCaminoLibre)
            assert.equals(true, self.caminoEstaLibre(matriz, caminosTerciarios.get(indiceMatriz)))
            assert.equals(true, self.caminoEstaLibre(matriz, caminosAdicionales.get(indiceMatriz)))
            assert.equals(true, self.ramasFalsasTerminanEnPortal(matriz, ramasFalsas.get(indiceMatriz)))
            indiceMatriz = indiceMatriz + 1
        })
    }

    method caminoEstaLibre(matriz, camino) {
        var caminoLibre = true
        camino.forEach({ coordenada =>
            if (self.esParedOPortal(matriz, coordenada.get(0), coordenada.get(1))) {
                caminoLibre = false
            }
        })
        return caminoLibre
    }

    method ramasFalsasTerminanEnPortal(matriz, ramas) {
        var ramasValidas = true
        ramas.forEach({ rama =>
            const ultimaPosicion = rama.size() - 1
            (0..ultimaPosicion).forEach({ indice =>
                const coordenada = rama.get(indice)
                const elemento = matriz.get(11 - coordenada.get(1)).get(coordenada.get(0))
                if (indice < ultimaPosicion) {
                    if (elemento == 1 || elemento == 4) {
                        ramasValidas = false
                    }
                } else if (elemento != 4) {
                    ramasValidas = false
                }
            })
        })
        return ramasValidas
    }

    method esParedOPortal(matriz, x, y) {
        const elemento = matriz.get(11 - y).get(x)
        return elemento == 1 || elemento == 4
    }
}
